.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.code-workspace

# ── Node / pnpm ────────────────────────────────────────────────
node_modules/
.pnpm-store/
*.tmp
*.tsbuildinfo
pnpm-debug.log*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

